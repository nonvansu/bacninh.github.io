<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BẮC NINH - Quan Họ & Văn Hiến</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;700;900&family=Cinzel:wght@700&display=swap" rel="stylesheet">
<style>
:root{--red:#9e1b1b;--gold:#f9d88a;--dark:#120202}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Be Vietnam Pro',sans-serif}
body{background:var(--dark);color:#fff;overflow-x:hidden}
section{position:relative;min-height:100vh;width:100%;overflow:hidden;display:flex;align-items:center;padding:6vw}
.curtain{position:absolute;inset:0;z-index:10;display:flex;pointer-events:none}
.curtain span{flex:1;background:repeating-linear-gradient(90deg,#b51d1d 0 40px,#9e1b1b 40px 80px);box-shadow:inset 0 0 20px rgba(0,0,0,.5);transition:transform 1.2s cubic-bezier(.8,0,.2,1)}
.curtain.open span:first-child{transform:translateX(-100%)}
.curtain.open span:last-child{transform:translateX(100%)}
h1{font-family:'Cinzel',serif;color:var(--gold);font-size:4.5vw;line-height:1;text-transform:uppercase;letter-spacing:2px;text-shadow:0 2px 20px rgba(249,216,138,.4)}
.glass{background:rgba(255,255,255,.06);backdrop-filter:blur(12px);border:1px solid rgba(249,216,138,.2);border-radius:18px;padding:14px 18px}
.gold{color:var(--gold)}
/* Hero */
#hero{background:radial-gradient(circle at 70% 50%, #3a1a0a, #120202)}
#hero img.tower{position:absolute;right:5%;bottom:0;height:85%;z-index:1}
/* Timeline */
.timeline{display:flex;gap:20px;margin-top:30px;width:100%}
.timeline .item{flex:1}
.timeline h3{color:var(--gold);margin-bottom:8px}
/* Mua */
.mua-btn{padding:8px 16px;border-radius:20px;border:1px solid #555;background:#111;color:#fff;cursor:pointer}
.mua-btn.active{background:var(--gold);color:#000;font-weight:900}
/* Anim */
.cloud{position:absolute;top:10%;right:15%;width:300px;opacity:.8;animation:float 6s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-20px)}}
</style>
</head>
<body>

<section id="hero">
  <div class="curtain"><span></span><span></span></div>
  <div style="z-index:2;max-width:520px">
    <p style="letter-spacing:4px;opacity:.7">TỔNG QUAN VỀ</p>
    <h1>BẮC NINH</h1>
    <div style="margin-top:20px;display:flex;flex-direction:column;gap:10px">
      <div class="glass">📍 Tên tiếng Hán: Bắc Ninh - Miền đất Quan Họ</div>
      <div class="glass">👑 Thủ phủ của xứ Kinh Bắc, cái nôi của văn hóa Phật giáo Việt Nam từ năm 187</div>
      <div class="glass">🎭 Trung tâm Quan Họ, lễ hội, làng nghề và giao thông huyết mạch phía Bắc</div>
    </div>
    <div style="display:flex;gap:12px;margin-top:20px">
      <div class="glass"><b class="gold" style="font-size:28px">1.4M+</b><br>Dân số 2024</div>
      <div class="glass"><b class="gold" style="font-size:28px">822</b><br>Km² diện tích</div>
    </div>
  </div>
  <img class="tower" src="https://i.imgur.com/8Km9tLL.png" alt="Chùa Dâu">
  <img class="cloud" src="https://i.imgur.com/Q8pP5eP.png">
</section>

<section id="lichsu" style="background:#1a0d0d">
  <div class="curtain"><span></span><span></span></div>
  <div style="z-index:2;width:100%">
    <p>BẮC NINH</p>
    <h1>Lịch sử phát triển</h1>
    <div class="timeline">
      <div class="glass item"><h3>CỔ ĐẠI</h3><p>Luy Lâu - trung tâm Phật giáo đầu tiên của Việt Nam, hơn 2000 năm lịch sử.</p></div>
      <div class="glass item"><h3>LÝ - TRẦN</h3><p>Đền Đô thờ 8 vị vua nhà Lý, phát tích vương triều Lý.</p></div>
      <div class="glass item"><h3>NGÀY NAY</h3><p>Từ làng nghề đến KCN Samsung, Bắc Ninh là tỉnh công nghiệp phát triển bậc nhất.</p></div>
    </div>
  </div>
</section>

<section id="bonmua">
  <div style="position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1540202404-a2f29016b523') center/cover;opacity:.5" id="muaBg"></div>
  <div style="z-index:2">
    <p>ĐỊA LÝ & KHÍ HẬU</p>
    <h1>Bắc Ninh<br>bốn mùa</h1>
    <div style="margin-top:20px;display:flex;gap:8px">
      <button class="mua-btn active" onclick="doiMua('xuân')">Mùa xuân</button>
      <button class="mua-btn" onclick="doiMua('hè')">Mùa hạ</button>
      <button class="mua-btn" onclick="doiMua('thu')">Mùa thu</button>
      <button class="mua-btn" onclick="doiMua('đông')">Mùa đông</button>
    </div>
    <h1 id="tenMua" style="margin-top:40px;font-size:5vw">MÙA XUÂN</h1>
    <p id="moTaMua">Hội Lim rộn rã, liền anh liền chị trẩy hội</p>
  </div>
</section>

<section id="danhlam" style="background:#fff7d6;color:#000;justify-content:center;text-align:center">
  <div class="curtain"><span></span><span></span></div>
  <div style="z-index:2">
    <p>DANH LAM THẮNG CẢNH</p>
    <h1 style="color:#9e1b1b;font-size:8vw">ĐỀN ĐÔ</h1>
    <p>Nơi thờ 8 vị vua nhà Lý - cội nguồn vương triều</p>
  </div>
</section>

<section id="amthuc" style="background:#120202">
  <div style="z-index:2;width:100%">
    <p class="gold">ẨM THỰC</p>
    <h1>Hương vị Bắc Ninh</h1>
    <div style="display:flex;gap:30px;margin-top:30px;align-items:center">
      <div><h2 style="color:var(--gold)">BÁNH PHU THÊ ĐÌNH BẢNG</h2><p>Biểu tượng phu thê chung thủy, dẻo thơm lá dừa.</p></div>
      <img src="https://i.imgur.com/k6a2E7g.png" style="width:300px;border-radius:50%">
    </div>
  </div>
</section>

<script>
// Hiệu ứng rèm mở khi scroll
const observer = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting) e.target.querySelector('.curtain')?.classList.add('open')
  })
},{threshold:0.5})
document.querySelectorAll('section').forEach(s=>observer.observe(s))

function doiMua(mua){
  document.querySelectorAll('.mua-btn').forEach(b=>b.classList.remove('active'))
  event.target.classList.add('active')
  const data={
    'xuân':['MÙA XUÂN','Hội Lim rộn rã, liền anh liền chị trẩy hội','https://images.unsplash.com/photo-1522383225653-ed111181a951'],
    'hè':['MÙA HÈ','Nắng vàng trên cánh đồng lúa Yên Phong','https://images.unsplash.com/photo-1500382017468-9049fed747ef'],
    'thu':['MÙA THU','Mùa cốm làng Diềm, lá vàng Đền Đô','https://images.unsplash.com/photo-1506744038136-46273834b3fb'],
    'đông':['MÙA ĐÔNG','Sương mờ chùa Dâu, ấm áp bánh phu thê','https://images.unsplash.com/photo-1491002052546-bf38f186af56']
  }
  document.getElementById('tenMua').innerText=data[mua][0]
  document.getElementById('moTaMua').innerText=data[mua][1]
  document.getElementById('muaBg').style.backgroundImage=`url('${data[mua][2]}')`
}
</script>
</body>
</html>
